# Handle line endings automatically for files detected as text 
# and leave binary files untouched.
* text=auto

#
# The following files should always have LF (Unix) line endings
# especially important for scripts running in Docker/Linux containers.
#
*.sh            text eol=lf
mvnw            text eol=lf
Dockerfile*     text eol=lf
.env*           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.js            text eol=lf
*.jsx           text eol=lf
*.css           text eol=lf
*.html          text eol=lf
*.java          text eol=lf
*.xml           text eol=lf
*.sql           text eol=lf

#
# The following files should always have CRLF (Windows) line endings.
#
*.bat           text eol=crlf
*.cmd           text eol=crlf

#
# Denote all files that are truly binary and should not be modified.
#
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.pdf           binary
*.docx          binary
*.doc           binary
*.xlsx          binary
*.xls           binary
*.pptx          binary
*.ppt           binary
*.mdj           binary
*.jar           binary
*.war           binary
