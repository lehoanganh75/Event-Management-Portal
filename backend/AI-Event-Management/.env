# Database Configuration (Docker names)
DB_HOST=mariadb-server
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=event_db

# Ollama Configuration (Docker names)
OLLAMA_URL=http://ollama-server:11434
OLLAMA_MODEL=event-assistant
OLLAMA_NUM_THREAD=4
OLLAMA_NUM_CTX=8192

# Server Configuration
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# AI Keys
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# AWS S3 Configuration
REGION=ap-southeast-1
ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_HERE
SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY_HERE
S3_BUCKET=moon-s3-demo